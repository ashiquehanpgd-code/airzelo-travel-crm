# build outputs and downloads (re-created by build/fetch_python.py and electron-builder)
dist/
build/cache/
build/runtime/
desktop/node_modules/
core/bin/
core/data/
__pycache__/
*.pyc
.DS_Store
# never commit customer or agency data
*.db
*.db-wal
*.db-shm

# logs
*.log

# secrets and signing material: never commit (Apple Developer ID / notarization keys, Windows code-signing certificates)
.env
.env.*
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# backups and archives (backups may contain customer data)
*.bundle
*.tar.gz
*.tgz
*.zip
**/AirZelo-backups/
*.sqlite
*.sqlite3

# iPhone app: Swift build output and generated Xcode project
ios/AirZeloKit/.build/
ios/AirZeloKit/.swiftpm/
ios/AirZelo/AirZelo.xcodeproj/
ios/build/
ios/AirZelo/Generated/
