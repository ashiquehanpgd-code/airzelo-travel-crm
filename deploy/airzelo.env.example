# /etc/airzelo/airzelo.env  (chmod 600, owner root). No secrets belong in the repository.
TACRM_MODE=cloud
# the address staff open; must be https:// and match the Caddyfile host
TACRM_PUBLIC_ORIGIN=https://crm.example.in
# take the visitor address from Caddy's X-Forwarded-For (only trusted from 127.0.0.1)
TACRM_TRUST_PROXY=1
TACRM_DATA_DIR=/var/lib/airzelo/agency
# the server never opens files; PDFs are downloaded by each user
TACRM_NO_OPEN=1
