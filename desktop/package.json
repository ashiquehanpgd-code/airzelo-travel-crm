{
  "name": "airzelo",
  "productName": "AirZelo",
  "version": "0.2.0",
  "description": "AirZelo - travel agency CRM and accounting for Windows and macOS",
  "author": "[LEGAL NAME PLACEHOLDER]",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.airzelo.crm",
    "productName": "AirZelo",
    "copyright": "Copyright © 2026 [LEGAL NAME PLACEHOLDER]",
    "directories": { "output": "../dist", "buildResources": "resources" },
    "files": ["main.js", "preload.js", "launcher/**", "package.json"],
    "extraResources": [
      { "from": "../core", "to": "core", "filter": ["run.py", "server/**", "static/**", "bin/**", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../build/runtime/${os}-${arch}/python", "to": "python", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dmg" }, { "target": "zip" }],
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": { "title": "${productName} ${version}" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "guid": "edbf4f81-513b-471e-8899-465f7e581c3f",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "AirZelo"
    }
  }
}
